{
  "name": "amayra-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "seed": "node dist/seed/seed.js",
    "seed:dev": "tsx src/seed/seed.ts",
    "seed:clean": "tsx src/seed/wipe.ts",
    "lint": "eslint src --max-warnings=100",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "prepare": "node scripts/prepare.mjs",
    "security:audit": "npm audit --omit=dev",
    "refactor:shims": "node scripts/write-shims.mjs",
    "refactor:fix-imports": "node scripts/fix-module-imports.mjs"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix --cache"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.0",
    "express-slow-down": "^3.1.0",
    "express-validator": "^7.2.1",
    "file-type": "^22.0.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.10.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "razorpay": "^2.9.6",
    "rotating-file-stream": "^3.2.9",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.1",
    "xss": "^1.0.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-mongo-sanitize": "^1.3.2",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.20.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  }
}