# Copy this file to .env and fill secrets. Do not commit .env.

# -----------------------------------------------------------------------------
# Core API
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/amayra
JWT_SECRET=change-me-in-production
# Comma-separated browser origins allowed to call the API (storefront ~3000, admin panel ~3001)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173

# -----------------------------------------------------------------------------
# Bootstrap admin account (seed / first login credentials)
ADMIN_EMAIL=admin@amayra.local
ADMIN_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Shiprocket (admin post-order fulfilment from Node — never expose secrets to browsers)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Base URL defaults to Shiprocket API v2; override only if docs point elsewhere.
# SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in
# Optional: override JWT cache TTL in seconds when API omits/expiry differs.
# SHIPROCKET_TOKEN_TTL_SECONDS=
# When the customer profile has no email, SR still expects billing_email.
SHIPROCKET_FALLBACK_EMAIL=noreply@example.com

# -----------------------------------------------------------------------------
# Razorpay (payments + webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Customer Google OAuth (verify GIS ID tokens; storefront uses same client id prefixed NEXT_PUBLIC_)
GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# Image uploads (admin Upload → product/category images)
# Auto: R2 if fully configured; else Cloudflare Images; else local ./uploads
# UPLOAD_STORAGE=r2
# UPLOAD_STORAGE=cloudflare_images
# UPLOAD_STORAGE=local

# Cloudflare R2 (S3-compatible)
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev   (managed dev URL → account id is inferred from hostname)
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
#
# S3 API endpoint — only needed if you use a custom public domain (not pub-*.r2.dev):
# (A) R2 → bucket → Settings → copy "S3 API":
# R2_S3_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
# (B) Or set account id explicitly:
# R2_ACCOUNT_ID=
# Aliases: CLOUDFLARE_ACCOUNT_ID, CF_ACCOUNT_ID

# Cloudflare Images (alternative to R2)
# CF_IMAGES_ACCOUNT_ID=
# CF_IMAGES_API_TOKEN=
